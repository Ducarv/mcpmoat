{
  "mcpServers": {
    "approved-srv": {
      "command": "npx",
      "args": ["-y", "approved-server"]
    },
    "rejected-srv": {
      "type": "stdio",
      "command": "uvx",
      "args": ["rejected-server"]
    },
    "pending-srv": {
      "command": "node",
      "args": ["pending-server.js"]
    },
    "repo-srv": {
      "command": "npx",
      "args": ["-y", "repo-server"]
    }
  }
}
